# Frontend Firebase config (public; safe to expose when Firestore/Auth Rules are correct)
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID

# Vercel server-side Admin SDK secrets (NEVER expose to frontend)
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@YOUR_PROJECT_ID.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_KEY\\n-----END PRIVATE KEY-----\\n"

# Bootstrap admin. Use only during initial setup, then rotate/remove BOOTSTRAP_SECRET.
ADMIN_EMAIL=admin@cbt.local
ADMIN_PASSWORD=hudasukses
BOOTSTRAP_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
